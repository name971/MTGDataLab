{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtgdatalab",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 古い価格履歴のアーカイブ用（Supabase無料枠500MB対策、db/schema.sql運用メモ参照）。
  // 直近はSupabase、90日より前の履歴はこちらのD1（無料枠5GB）に移す。
  "d1_databases": [
    {
      "binding": "PRICE_ARCHIVE_DB",
      "database_name": "jp-mtgstocks-archive",
      "database_id": "a3f8dcb4-80d1-4dba-81dd-9ecd900e7623"
    }
  ],
  // ISR(ページキャッシュ)の永続ストア。KVを使う（open-next.config.ts参照。Supabase egress対策）。
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "0512dda9d33647c9863bd336c44cf592"
    }
  ],
  // デッキ未使用カードを含む全カードの長期価格履歴（2024-02〜、月次Parquet、
  // ml/fetch_tcgcsv_history.py参照）。D1は1日あたりの読み書き行数に上限があり
  // 全カード×数年分の書き込みには向かないため、R2（行数でなくリクエスト回数課金）を使う。
  "r2_buckets": [
    {
      "binding": "PRICE_ARCHIVE_R2",
      "bucket_name": "jp-mtgstocks-price-archive"
    }
  ]
}
